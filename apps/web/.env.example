# Copy to .env.local and fill in. Values come from `pnpm db:status` (local)
# or the Supabase dashboard (staging). Only public, browser-safe values belong here:
# the anon key is public by design and is protected by RLS. NEVER put the
# service_role key in a VITE_ variable — it would ship to every browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
