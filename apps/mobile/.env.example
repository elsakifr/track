# Copy to .env.local and fill in. EXPO_PUBLIC_ values are embedded in the app
# bundle and are therefore public. NEVER put the service_role key here.
# On a physical device, 127.0.0.1 is the phone itself — use your computer's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
